{
  "name": "Deadzone",
  "version": "1.3",
  "productName": "Deadzone Demo",
  "description": "3D FPS Game",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "engines": {"node": ">=24 <25"},
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test",
    "preview:build": "node scripts/build-preview.mjs",
    "desktop": "electron .",
    "dist": "node scripts/build-desktop.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "socket.io": "^4.8.1",
    "three": "^0.181.0",
    "@fontsource/barlow": "^5.2.6",
    "@fontsource/barlow-condensed": "^5.2.6"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.25.12",
    "socket.io-client": "^4.8.1"
  },
  "build": {
    "appId": "game.deadzone.desktop",
    "directories": {"output": "dist"},
    "files": [
      "desktop/**/*",
      "server.js",
      "public/**/*",
      "shared/**/*",
      "src/**/*",
      "Weapons/**/*",
      "Assets/**/*",
      "Images/**/*",
      "package.json",
      {
        "from": "node_modules/three/examples/jsm",
        "to": "node_modules/three/examples/jsm",
        "filter": [
          "loaders/GLTFLoader.js",
          "utils/BufferGeometryUtils.js",
          "utils/SkeletonUtils.js"
        ]
      }
    ],
    "win": {
      "target": ["portable"],
      "icon": "desktop/icon.ico",
      "artifactName": "Deadzone-Game-${version}-Windows-${arch}.${ext}"
    }
  }
}
